# AM Risk — Production Environment
# Copy to .env and fill. Docker Compose reads this file.

# ── Database ──
DB_PASSWORD=changeme-in-prod

# ── Auth ──
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── LLM (optional — extractive fallback works without) ──
LLM_PROVIDER=none
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=@amrisk_channel,-1001234567890

# ── WhatsApp ──
WHATSAPP_PROVIDER=none
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+27XXXXXXXXX
GREENAPI_ID=
GREENAPI_TOKEN=
GREENAPI_GROUP_ID=

# ── Email ──
EMAIL_MODE=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AM Risk Briefing <briefing@example.com>
EMAIL_TO=ops@example.com
RESEND_API_KEY=

# ── Pipeline ──
GPU_ENABLED=true
GPU_MODEL_PATH=/app/models
MAX_BRIEF_DURATION=120
APPROVAL_REQUIRED=true
AUTO_PUBLISH_EMAIL=false
DAILY_CRON_HOUR=6
DAILY_CRON_MINUTE=0
DATA_DIR=/app/data

# ── Monitoring ──
SENTRY_DSN=
